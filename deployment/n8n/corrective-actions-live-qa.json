        ]
      ]
    },
    "Verify supervisor acceptance": {
      "main": [
        [
          {
            "node": "Record notification receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record notification receipt": {
      "main": [
        [
          {
            "node": "Require durable completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require durable completion": {
      "main": [
        [
          {
            "node": "Workflow completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
