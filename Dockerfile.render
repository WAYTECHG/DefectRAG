FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    RESULTS_DIR=/tmp/defectrag/results \
    REFERENCE_DIR=/tmp/defectrag/references

WORKDIR /app
COPY requirements-render.txt ./
RUN pip install --upgrade pip && pip install -r requirements-render.txt
COPY . .
RUN mkdir -p /tmp/defectrag/results /tmp/defectrag/references

EXPOSE 10000
CMD uvicorn app.render_main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers
