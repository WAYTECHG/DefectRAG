DEFECTRAG_DEVICE=auto
# auto selects a fully installed high-resolution profile; legacy preserves the original detector.
DEFECTRAG_PROFILE=auto
# Bundled model paths are the default. Use absolute paths only when overriding.
# DEFECTRAG_ENCODER=C:/path/to/authorized/dinov3/snapshot
# DEFECTRAG_EMBEDDING=C:/path/to/bge-small-en-v1.5/snapshot
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Local single-user app: bind only to localhost. Configure exact frontend origins for development.
DEFECTRAG_CORS=http://localhost:5173,http://127.0.0.1:5173
# DEFECTRAG_DATA=C:/path/to/private/runtime
